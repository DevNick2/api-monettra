PYTHONUNBUFFERED=
PYTHONIOENCODING=
LOG_LEVEL=
PYTHON_ENV=

# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DB=

# CORS — origens permitidas (separadas por vírgula)
# Ex: https://app.monettra.com,https://www.monettra.com
CORS_ORIGINS=http://localhost:8080

# JWT
JWT_SECRET_KEY=changeme-super-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI Provider (openai | anthropic)
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENROUTER_API_KEY=

# Legacy / outros
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REDIS_HOST=
REDIS_PORT=

#Traefik host
TRAEFIK_HOST=

# SMTP (e-mail transacional)
# Desenvolvimento: Mailhog (SMTP_HOST=mailhog, SMTP_PORT=1025, UI em http://localhost:8025)
# Produção (Hostinger): configurar com dados reais
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@monettra.app
SMTP_USE_TLS=false

# URL pública do app (usada nos links de convite)
APP_PUBLIC_URL=http://localhost:8080